{
  "name": "@dennoa/azure-sso-handler",
  "version": "1.0.0",
  "description": "Azure SSO Handler library for authentication and token management.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && npm run copy-html",
    "build:prod": "npm run clean && tsc --project tsconfig.prod.json",
    "copy-html": "copyfiles -u 1 \"src/**/*.html\" dist/",
    "test": "npm run build && dotenvx run -- node dist/ssoHandler.test.server.js"
  },
  "keywords": [
    "azure",
    "sso",
    "authentication",
    "typescript"
  ],
  "author": "dennoa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennoa/azure-sso-handler.git"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^26.6.11",
    "cookie-parser": "^1.4.7",
    "copyfiles": "^2.4.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@azure/msal-node": "^7.2.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0"
  }
}
